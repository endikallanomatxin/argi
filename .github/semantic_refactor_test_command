python3 - <<'PY'
from pathlib import Path
p = Path("src/4_semantics/global/verify.zig")
s = p.read_text()
s = s.replace("try require(", "try requireAt(@src(), ")
old = '''fn require(ok: bool) !void {
    if (!ok) return error.InvalidGlobalSemanticGraph;
}'''
new = '''fn requireAt(src: std.builtin.SourceLocation, ok: bool) !void {
    if (!ok) {
        std.debug.print("GLOBAL_VERIFY_FAIL {s}:{d}\\n", .{ src.file, src.line });
        return error.InvalidGlobalSemanticGraph;
    }
}'''
if old not in s:
    raise SystemExit("missing require anchor")
s = s.replace(old, new, 1)
p.write_text(s)
PY
zig build test-programs -Dtest-filter=feature_tests/polymorphism/08_abstract
