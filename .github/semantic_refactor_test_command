repl='''    fn resolve(self: *Resolver, o: globalizer.Offsets, value: anytype) !bool {
        const errable = globalizer.globalNode(o, value.errable_value);
        const errable_ty = self.graph.nodes.items[@intFromEnum(errable)].ty orelse {
            std.debug.print("ERROR_TRACE missing errable type node={d}\\n", .{@intFromEnum(errable)});
            return false;
        };
        std.debug.print("ERROR_TRACE errable={d} ty={d} tag={s} variants={}\\n", .{
            @intFromEnum(errable),
            @intFromEnum(errable_ty),
