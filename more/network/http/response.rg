-- Response framing is generated by this module. Caller headers cannot override it.
_http_response_valid_headers := (.headers: ArrayView#(Header)) -> (.ok: Bool = false) {
    index :: UIntNative = 0
    while index < length(&headers).count {
        header ::= unwrap_or_abort(.value = get_reference(&headers, .index = index))&
        if length(&header.name).count == 0 { return }
        if [
            _ascii_equal(.bytes = header.name, .text = "content-length").ok
            or _ascii_equal(.bytes = header.name, .text = "transfer-encoding").ok
            or _ascii_equal(.bytes = header.name, .text = "connection").ok
            or _ascii_equal(.bytes = header.name, .text = "trailer").ok
        ] { return }
        position :: UIntNative = 0
        while position < length(&header.name).count {
            byte ::= unwrap_or_abort(.value = get_reference(&header.name, .index = position))&
            if _token(.byte = byte).ok == false { return }
            position = position + 1
        }
        position = 0
        while position < length(&header.value).count {
            byte ::= unwrap_or_abort(.value = get_reference(&header.value, .index = position))&
            if [byte < 32 and byte != 9] or byte == 127 { return }
            position = position + 1
        }
        index = index + 1
    }
    ok = true
}

_http_response_reason := (.status: UInt16) -> (.text: StringView = "") {
    if status == 200 { text = "OK" }
    if status == 201 { text = "Created" }
    if status == 202 { text = "Accepted" }
    if status == 204 { text = "No Content" }
    if status == 205 { text = "Reset Content" }
    if status == 301 { text = "Moved Permanently" }
    if status == 302 { text = "Found" }
    if status == 303 { text = "See Other" }
    if status == 304 { text = "Not Modified" }
    if status == 307 { text = "Temporary Redirect" }
    if status == 308 { text = "Permanent Redirect" }
    if status == 400 { text = "Bad Request" }
    if status == 401 { text = "Unauthorized" }
    if status == 403 { text = "Forbidden" }
    if status == 404 { text = "Not Found" }
    if status == 405 { text = "Method Not Allowed" }
    if status == 408 { text = "Request Timeout" }
    if status == 409 { text = "Conflict" }
    if status == 413 { text = "Content Too Large" }
    if status == 415 { text = "Unsupported Media Type" }
    if status == 417 { text = "Expectation Failed" }
    if status == 422 { text = "Unprocessable Content" }
    if status == 429 { text = "Too Many Requests" }
    if status == 431 { text = "Request Header Fields Too Large" }
    if status == 500 { text = "Internal Server Error" }
    if status == 501 { text = "Not Implemented" }
    if status == 502 { text = "Bad Gateway" }
    if status == 503 { text = "Service Unavailable" }
    if status == 504 { text = "Gateway Timeout" }
}

_http_response_text := #(.W: Type: BlockWriter#(W)) (.writer: $&W, .text: StringView) -> (
    .result : Errable#(Void, HttpReasons)
) {
    write_all(.self = writer, .buffer = string_bytes(.text = text))!
    result = ..ok Void()
}

_http_response_number := #(.W: Type: BlockWriter#(W)) (.writer: $&W, .number: UIntNative) -> (
    .result : Errable#(Void, HttpReasons)
) {
    digits :: [20]UInt8 = zeroed#([20]UInt8)()
    offset :: UIntNative = 20
    remaining ::= number
    while true {
        offset = offset - 1
        digits[offset] = unwrap_or_abort(
            .value = [[remaining % 10 + 48] | convert#(.to: UInt8)(_)]
        )
        remaining = remaining / 10
        if remaining == 0 { break }
    }
    all ::= view(&digits)
    tail ::= unwrap_or_abort(.value = slice(&all, .start = offset, .count = [20 - offset]))
    write_all(.self = writer, .buffer = tail)!
    result = ..ok Void()
}

_http_write_response_head := #(.W: Type: BlockWriter#(W)) (
    .writer: $&W, .status: UInt16, .headers: ArrayView#(Header), .body_length: UIntNative
) -> (.result: Errable#(Void, HttpReasons)) {
    _http_response_text(.writer = writer, .text = "HTTP/1.1 ")!
    _http_response_number(.writer = writer, .number = status | convert#(.to: UIntNative)(_))!
    _http_response_text(.writer = writer, .text = " ")!
    _http_response_text(.writer = writer, .text = _http_response_reason(.status = status).text)!
    _http_response_text(.writer = writer, .text = "\r\nConnection: close\r\n")!
    if status != 204 and status != 304 {
        _http_response_text(.writer = writer, .text = "Content-Length: ")!
        _http_response_number(.writer = writer, .number = body_length)!
        _http_response_text(.writer = writer, .text = "\r\n")!
    }
    index :: UIntNative = 0
    while index < length(&headers).count {
        header ::= unwrap_or_abort(.value = get_reference(&headers, .index = index))&
        write_all(.self = writer, .buffer = header.name)!
        _http_response_text(.writer = writer, .text = ": ")!
        write_all(.self = writer, .buffer = header.value)!
        _http_response_text(.writer = writer, .text = "\r\n")!
        index = index + 1
    }
    _http_response_text(.writer = writer, .text = "\r\n")!
    result = ..ok Void()
}

write_response := #(.W: Type: BlockWriter#(W)) (
    .writer    : $&W,
    .status    : UInt16             = 200,
    .headers   : ArrayView#(Header) = empty_array_view#(Header)().array,
    .body      : ArrayView#(UInt8),
    .head_only : Bool               = false
) -> (.result: Errable#(Void, HttpReasons)) {
    if [
        status < 200
        or status > 599
        or [[status == 204 or status == 205 or status == 304] and length(&body).count != 0]
        or _http_response_valid_headers(.headers = headers).ok == false
    ] {
        result = ..error(.reason = ..invalid_response)
        return
    }
    _http_write_response_head(
        .writer      = writer
        .status      = status
        .headers     = headers
        .body_length = length(&body).count
    )!
    if head_only == false { write_all(.self = writer, .buffer = body)! }
    result = ..ok Void()
}

-- The writer borrows the underlying stream. Failed or incomplete responses cannot
-- be resumed, since an output failure may already have emitted a partial frame.
ResponseWriter := #(.W: Type: BlockWriter#(W)) (
    ._writer    : $&W,
    ._remaining : UIntNative,
    ._head_only : Bool,
    ._active    : Bool
)

begin_response := #(.W: Type: BlockWriter#(W)) (
    .writer    : $&W,
    .status    : UInt16             = 200,
    .headers   : ArrayView#(Header) = empty_array_view#(Header)().array,
    .length    : UIntNative,
    .head_only : Bool               = false
) -> (.result: Errable#(ResponseWriter#(W), HttpReasons)) {
    if [
        status < 200
        or status > 599
        or [[status == 204 or status == 205 or status == 304] and length != 0]
        or _http_response_valid_headers(.headers = headers).ok == false
    ] {
        result = ..error(.reason = ..invalid_response)
        return
    }
    _http_write_response_head(
        .writer = writer, .status = status, .headers = headers, .body_length = length
    )!
    result = ..ok(
        ._writer    = writer
        ._remaining = length
        ._head_only = head_only
        ._active    = true
    )
}

write_body := #(.W: Type: BlockWriter#(W)) (
    .self: $&ResponseWriter#(W), .body: ArrayView#(UInt8)
) -> (.result: Errable#(Void, HttpReasons)) {
    count ::= length(&body).count
    if self&._active == false or count > self&._remaining {
        self&._active = false
        result = ..error(.reason = ..invalid_state)
        return
    }
    if self&._head_only == false {
        write_all(.self = self&._writer, .buffer = body) handle error {
            self&._active = false
            match error.reason {
                ..stream_write_failed { result = ..error(.reason = ..stream_write_failed) }
                ..stream_flush_failed { result = ..error(.reason = ..stream_flush_failed) }
            }
            return
        }
    }
    self&._remaining = self&._remaining - count
    result = ..ok Void()
}

finish_response := #(.W: Type: BlockWriter#(W)) (.self: $&ResponseWriter#(W)) -> (
    .result : Errable#(Void, HttpReasons)
) {
    if self&._active == false or [self&._remaining != 0 and self&._head_only == false] {
        self&._active = false
        result = ..error(.reason = ..invalid_state)
        return
    }
    self&._active = false
    result = ..ok Void()
}
