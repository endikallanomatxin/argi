-- Expected values are exact binary rationals rounded from the input decimal.
-- Cases cover each IEEE width, deterministic varied significands, boundaries,
-- and decimal exponents cancelled by long leading or trailing zero sequences.
expect_float16(.text: StringView, .expected: Float16) -> () := {
    actual ::= unwrap_or_abort(.value = parse_float16(.text = text)).result
    if actual != expected { abort }
}

expect_float32(.text: StringView, .expected: Float32) -> () := {
    actual ::= unwrap_or_abort(.value = parse_float32(.text = text)).result
    if actual != expected { abort }
}

expect_float64(.text: StringView, .expected: Float64) -> () := {
    actual ::= unwrap_or_abort(.value = parse_float64(.text = text)).result
    if actual != expected { abort }
}

expect_error#(
        .t : Type: Float
    )(
        .value  : Errable#(.t: t, .reasons: (..invalid_input, ..out_of_range)),
        .reason : (..invalid_input, ..out_of_range),
    ) -> () := {
    match value {
        ..ok _ { abort }
        ..error error { if error.reason != reason { abort } }
    }
}

main() -> (.status_code: Int32 = 0) := {
    expect_float16(.text = "0", .expected = 0.0)
    expect_float16(.text = "-0", .expected = 0.0)
    expect_float16(.text = "+0", .expected = 0.0)
    expect_float16(.text = "0e999999999999999999999", .expected = 0.0)
    expect_float16(.text = "-0e-99999999999999999999", .expected = 0.0)
    expect_float16(.text = "1", .expected = 1.0)
    expect_float16(.text = "+1.5", .expected = 1.5)
    expect_float16(.text = "-2.25", .expected = -2.25)
    expect_float16(.text = ".5", .expected = 0.5)
    expect_float16(.text = "5.", .expected = 5.0)
    expect_float16(.text = "00012.5000", .expected = 12.5)
    expect_float16(.text = "3.25e+2", .expected = 325.0)
    expect_float16(.text = "-3.25E-2", .expected = -0.032501220703125)
    expect_float16(.text = "0.1", .expected = 0.0999755859375)
    expect_float16(.text = "0.3", .expected = 0.300048828125)
    expect_float16(.text = "65504", .expected = 65504.0)
    expect_float16(.text = "65519", .expected = 65504.0)
    expect_error#(.t: Float16)(
        .value  = parse_float16(.text = "65520").result
        .reason = ..out_of_range
    )
    expect_error#(.t: Float16)(
        .value  = parse_float16(.text = "65536").result
        .reason = ..out_of_range
    )
