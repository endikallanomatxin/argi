        .expected = 1.0
    )
    expect_float64(
        .text = "-3000"

        .expected = 1.0
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = ".").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "+").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "-").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "e1").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "1e").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "1e+").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "1e-").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = " 1").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "1 ").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "1_0").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "1,5").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "0x1p2").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "nan").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "inf").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "1.2.3").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "1e999999999999999999999x").result
        .reason = ..invalid_input
    )
    expect_error#(.t: Float64)(
        .value  = parse_float64(.text = "1\0").result
        .reason = ..invalid_input
    )
    expect_float16(
        .text = "1."

        .expected = 1.0
    )
    expect_float16(
        .text = "1."

        .expected = 1.0009765625
    )
    negative16 ::= unwrap_or_abort(.value = parse_float16(.text = "-0.000e9999999999999")).result
    one16: Float16 = 1.0
    zero16: Float16 = 0.0
    if one16 / negative16 >= zero16 { abort }
    negative32 ::= unwrap_or_abort(.value = parse_float32(.text = "-0.000e9999999999999")).result
    one32: Float32 = 1.0
    zero32: Float32 = 0.0
    if one32 / negative32 >= zero32 { abort }
    negative64 ::= unwrap_or_abort(.value = parse_float64(.text = "-0.000e9999999999999")).result
    one64: Float64 = 1.0
    zero64: Float64 = 0.0
    if one64 / negative64 >= zero64 { abort }
    -- Halfway at the smallest binary64 subnormal, including a sticky tail
    -- past the retained decimal prefix, must never suffer double rounding.
    expect_error#(.t: Float64)(
        .value = parse_float64(
            .text = "0."
        ).result

        .reason = ..out_of_range
    )
    expect_float64(
        .text = "0."

        .expected = 4.-324
    )
    expect_float64(
        .text = "1."

        .expected = 1.0
    )
    expect_float64(
        .text = "1."

        .expected = 1.0000000000000002220446049250313080847263336181640625
    )
}
